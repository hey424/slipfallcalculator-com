---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = 'What to Do After a Slip & Fall | slipfallcalculator.com';
const description = 'Immediate steps to protect your health and your legal rights after a slip and fall accident.';
---
<BaseLayout title={title} description={description}>
  <h1>What to Do After a Slip &amp; Fall</h1>
  <h2>At the Scene</h2>
  <ul>
    <li>Don't leave without documenting the hazard — photograph it immediately.</li>
    <li>Ask for witnesses' names and contact information.</li>
    <li>Request that the property owner or manager fill out an incident report; get a copy.</li>
    <li>Do not apologize or admit fault — your words can be used against you.</li>
  </ul>
  <h2>Within 24–48 Hours</h2>
  <ul>
    <li>See a doctor, even if symptoms seem minor. Adrenaline can mask pain.</li>
    <li>Write down everything you remember about the accident while it's fresh.</li>
    <li>Send a written demand to the property owner to preserve surveillance footage.</li>
  </ul>
  <h2>Within 30 Days</h2>
  <ul>
    <li>Consult a personal injury attorney (most offer free consultations).</li>
    <li>If the property is government-owned, check your state's notice of claim deadline — it may be as short as 60 days.</li>
    <li>Do not give a recorded statement to the property owner's insurer without legal representation.</li>
  </ul>
  <h2>Ongoing</h2>
  <ul>
    <li>Keep all medical records, bills, and receipts.</li>
    <li>Track lost wages with pay stubs or employer letters.</li>
    <li>Maintain a pain journal documenting daily symptoms and limitations.</li>
  </ul>
</BaseLayout>
